# Preserve the content-addressed NH3-FINAL-1.1 source bundle byte-for-byte.
# The SOURCE_MANIFEST.json hashes refer to the original source-harness bytes;
# line-ending normalization would invalidate that provenance on checkout.
provenance/nh3_final_1_1/source_harness/** -text

# Same rule for the vendored DISCOVER V1 bundle: SOURCE_MANIFEST.json hashes refer to the
# original source-harness bytes, so line-ending normalization on checkout would invalidate
# the provenance on any machine that clones the repository.
provenance/discover_v1/source_harness/** -text

# The figure render manifests (figures/*/*_RENDER_SHA256.txt) hash the bytes as
# stored, so the same rule has to cover the manifests and every file they list.
# Without it, `sha256sum -c` fails on any CRLF checkout for reasons that have
# nothing to do with the science: on a Windows clone, 14 of the 33 covered
# entries failed while the LF bytes in the repository were correct all along.
figures/*/*_RENDER_SHA256.txt -text
figures/**/*.svg -text
figures/**/*.R -text
figures/**/*.py -text
data/**/*.csv -text
analysis/supervisor_2026_09_20/*.csv -text
# Fig. 3 render manifest (figures/composite/FIG3_RENDER_SHA256.txt) also lists these analysis outputs.
analysis/fe_bridge_backward_2026_09_29/*.csv -text
analysis/fe_bridge_backward_2026_09_29/*.json -text
analysis/supervisor_2026_09_20/*.json -text
analysis/promoted_ru_literature_2026_10_05/*.csv -text
# NH3-FINAL-1.2 inputs listed by the Fig. 3 and F03 render manifests (same reason as above).
analysis/supervisor_2026_09_20/nh3_1_2/*.csv -text
analysis/supervisor_2026_09_20/nh3_1_2/*.json -text
analysis/promoted_ru_literature_2026_10_05/nh3_1_2/*.csv -text
provenance/nh3_final_1_2/source_harness/outputs/nh3_final_1_2_20261013/results.json -text
provenance/nh3_final_1_2/source_harness/outputs/nh3_final_1_2_20261013/closure/*.csv -text
