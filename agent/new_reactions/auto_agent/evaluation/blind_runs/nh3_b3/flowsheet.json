{
  "units": [
    {
      "name": "H2 feed compressor",
      "type": "compressor",
      "purpose": "Compress purified hydrogen from battery-limit pressure to synthesis-loop pressure",
      "inlets": [
        "H2 feed"
      ],
      "outlets": [
        "compressed H2"
      ]
    },
    {
      "name": "N2 feed compressor",
      "type": "compressor",
      "purpose": "Compress purified nitrogen from battery-limit pressure to synthesis-loop pressure",
      "inlets": [
        "N2 feed"
      ],
      "outlets": [
        "compressed N2"
      ]
    },
    {
      "name": "makeup gas mixer",
      "type": "other",
      "purpose": "Combine stoichiometric compressed makeup hydrogen and nitrogen",
      "inlets": [
        "compressed H2",
        "compressed N2"
      ],
      "outlets": [
        "makeup gas"
      ]
    },
    {
      "name": "loop feed mixer",
      "type": "other",
      "purpose": "Combine makeup gas with compressed recycle gas",
      "inlets": [
        "makeup gas",
        "compressed recycle gas"
      ],
      "outlets": [
        "combined loop feed"
      ]
    },
    {
      "name": "feed effluent heat exchanger",
      "type": "heat_exchanger",
      "purpose": "Recover reactor-effluent sensible heat into the combined loop feed",
      "inlets": [
        "combined loop feed",
        "temperature-controlled reactor effluent"
      ],
      "outlets": [
        "preheated loop feed",
        "cooled reactor effluent"
      ]
    },
    {
      "name": "recovered-heat trim exchanger",
      "type": "heat_exchanger",
      "purpose": "Use recovered reactor heat or steam to supply residual steady-state feed preheat without purchased fuel",
      "inlets": [
        "preheated loop feed"
      ],
      "outlets": [
        "reactor feed"
      ]
    },
    {
      "name": "ammonia synthesis reactor",
      "type": "reactor",
      "purpose": "Convert N2 and H2 to NH3 in multiple fixed catalyst beds with interbed heat removal",
      "inlets": [
        "reactor feed"
      ],
      "outlets": [
        "hot reactor effluent"
      ]
    },
    {
      "name": "interbed heat recovery exchanger",
      "type": "heat_exchanger",
      "purpose": "Represent integrated interbed cooling and converter outlet steam generation for temperature control",
      "inlets": [
        "hot reactor effluent"
      ],
      "outlets": [
        "temperature-controlled reactor effluent"
      ]
    },
    {
      "name": "ammonia condenser separator",
      "type": "separation",
      "purpose": "Cool the high-pressure loop gas, condense NH3, and separate liquid ammonia from unreacted gas",
      "inlets": [
        "cooled reactor effluent"
      ],
      "outlets": [
        "crude liquid ammonia",
        "separator gas"
      ]
    },
    {
      "name": "purge splitter",
      "type": "other",
      "purpose": "Purge a small gas fraction to prevent accumulation of feed impurities while sending the balance to recycle",
      "inlets": [
        "separator gas"
      ],
      "outlets": [
        "purge gas",
        "recycle gas"
      ]
    },
    {
      "name": "recycle compressor",
      "type": "compressor",
      "purpose": "Restore recycle-gas pressure losses and return unreacted N2 and H2 to the loop",
      "inlets": [
        "recycle gas"
      ],
      "outlets": [
        "compressed recycle gas"
      ]
    },
    {
      "name": "NH3 product letdown",
      "type": "other",
      "purpose": "Reduce liquid-ammonia pressure to the product battery-limit pressure",
      "inlets": [
        "crude liquid ammonia"
      ],
      "outlets": [
        "NH3 product"
      ]
    },
    {
      "name": "purge handling and offsites",
      "type": "offsites",
      "purpose": "Safely meter and route the small hydrogen-rich purge and provide loop electrical/cooling-water infrastructure",
      "inlets": [
        "purge gas"
      ],
      "outlets": [
        "treated purge"
      ]
    }
  ],
