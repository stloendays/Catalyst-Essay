{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "doi",
  "title",
  "records",
  "extraction_notes"
 ],
 "properties": {
  "doi": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "records": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "entry_label": {
      "type": "string",
      "description": "Short unique label, e.g. 'Table 1 row 3' or 'Fig 3a, 400 C'."
     },
     "catalyst_name": {
      "type": "string",
      "description": "Catalyst name exactly as the paper writes it."
     },
     "composition": {
      "type": [
       "string",
       "null"
      ],
      "description": "Composition as stated, e.g. '2 wt% Ru, Cs/Ru = 1'."
     },
     "active_metal": {
      "type": [
       "string",
       "null"
      ],
      "description": "Element symbol of the catalytic metal (Ru, Fe, Co, Ni, Mo, Os, Re, ...). Several metals: join with ';' (e.g. 'Co;Mo'). Promoters and support cations are not active metals."
     },
     "metal_loading": {
      "$ref": "#/$defs/num"
     },
     "components": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "component",
        "role",
        "loading"
       ],
       "properties": {
        "component": {
         "type": "string",
         "description": "Element or compound, e.g. 'Ru', 'Fe', 'Cs', 'BaO', 'MgO', 'C12A7:e-'."
        },
        "role": {
         "type": "string",
         "enum": [
          "active_metal",
          "promoter",
          "support"
         ]
        },
        "loading": {
         "$ref": "#/$defs/num"
        }
       }
      }
     },
     "support": {
      "type": [
       "string",
       "null"
      ]
     },
     "promoters": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "preparation": {
      "type": [
       "string",
       "null"
      ],
      "description": "Distinguishing preparation detail (method, calcination/reduction T, morphology) when the paper uses it to tell catalysts apart."
     },
     "temperature": {
      "$ref": "#/$defs/num"
     },
     "pressure": {
      "$ref": "#/$defs/num"
     },
     "h2_n2_ratio": {
      "$ref": "#/$defs/num"
     },
     "feed_composition": {
      "type": [
       "string",
       "null"
      ],
      "description": "Feed as stated, e.g. 'H2/N2 = 3', '75% H2, 25% N2'."
     },
     "space_velocity": {
      "$ref": "#/$defs/num"
     },
     "space_velocity_basis": {
      "type": "string",
      "enum": [
       "per_mass_catalyst",
       "per_volume_catalyst",
       "unspecified"
      ]
     },
     "catalyst_mass": {
      "$ref": "#/$defs/num"
     },
     "total_flow": {
      "$ref": "#/$defs/num"
     },
     "time_on_stream": {
      "$ref": "#/$defs/num"
     },
     "outlet_nh3": {
      "$ref": "#/$defs/num"
     },
     "rate": {
      "$ref": "#/$defs/num"
     },
     "rate_basis": {
      "type": "string",
      "enum": [
       "per_g_catalyst",
       "per_g_metal",
       "per_mol_metal",
       "per_mL_catalyst",
       "per_m2",
       "other",
       "unspecified"
      ]
     },
     "tof": {
      "$ref": "#/$defs/num"
     },
     "tof_basis": {
      "type": [
       "string",
       "null"
      ],
      "description": "How the TOF is normalised, e.g. 'per surface Ru atom (CO chemisorption)', 'per total Ru'."
     },
     "operation_mode": {
      "type": "string",
      "enum": [
       "steady_thermal_catalytic",
       "chemical_looping",
       "plasma",
       "electric_field",
       "microwave",
       "photo",
       "other"
      ]
     },
     "data_source_type": {
      "type": "string",
      "enum": [
       "table",
       "text",
       "figure",
       "mixed"
      ]
     },
     "primary_location": {
      "type": "string",
      "description": "Main table/figure holding the rate."
     },
     "primary_page": {
      "type": [
       "integer",
       "null"
      ]
     },
     "notes": {
      "type": [
       "string",
       "null"
      ],
      "description": "Anything needed to interpret the entry (e.g. 'conditions from Experimental 2.3', 'equilibrium-limited', 'after 50 h on stream')."
     }
    },
    "required": [
     "entry_label",
     "catalyst_name",
     "composition",
     "active_metal",
     "metal_loading",
     "components",
     "support",
     "promoters",
     "preparation",
     "temperature",
     "pressure",
     "h2_n2_ratio",
     "feed_composition",
     "space_velocity",
     "space_velocity_basis",
     "catalyst_mass",
     "total_flow",
     "time_on_stream",
     "outlet_nh3",
     "rate",
     "rate_basis",
     "tof",
     "tof_basis",
     "operation_mode",
     "data_source_type",
     "primary_location",
     "primary_page",
     "notes"
    ]
   }
  },
  "extraction_notes": {
   "type": [
    "string",
    "null"
   ],
   "description": "Paper-level notes: data only in SI, figures not readable, etc."
  }
 },
 "$defs": {
  "num": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "value",
    "unit",
    "qualifier",
    "location",
    "page"
   ],
   "properties": {
    "value": {
     "type": [
      "number",
      "null"
     ],
     "description": "Number exactly as reported (no unit conversion). null if the paper does not report it for this entry."
    },
    "unit": {
     "type": [
      "string",
      "null"
     ],
     "description": "Unit as reported, e.g. '°C', 'K', 'MPa', 'bar', 'atm', 'wt%', 'mL g-1 h-1', 'h-1', 'vol%', 'ppm', 'umol g-1 h-1', 'mmol gRu-1 h-1', 's-1'."
    },
    "qualifier": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "=",
      "<",
      ">",
      "<=",
      ">=",
      "~",
      null
     ],
     "description": "'=' for a printed number, '<'/'>' for bounds, '~' for a value read off a plot."
    },
    "location": {
     "type": [
      "string",
      "null"
     ],
     "description": "Where the number is printed: 'Table 2', 'Figure 3b', 'Experimental section 2.3', 'Table 1 footnote'."
    },
    "page": {
     "type": [
      "integer",
      "null"
     ],
     "description": "1-based PDF page from the === PAGE n === marker."
    }
   }
  }
 }
}